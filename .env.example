# ============================================================
# 复制为 .env 后按需修改（.env 不要提交到 git）
# ============================================================

# ---------- 应用 ----------
APP_NAME="Election Management & Voting System"
DEBUG=false

# ---------- 安全 ----------
# ⚠️ 生产必须换成随机长字符串，可用:
#    python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="change-me-to-a-long-random-string"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ---------- 数据库 ----------
# 目标环境：PostgreSQL（推荐）
DATABASE_URL="postgresql+asyncpg://election:election@localhost:5432/election"
# 本地开发无 PostgreSQL 时，改用 SQLite：
# DATABASE_URL="sqlite+aiosqlite:///./data/app.db"
DB_ECHO=false

# ---------- 缓存 / 发布订阅 ----------
# 留空 = 使用进程内实现（单实例可用，适合开发与演示）
# 生产建议填 Redis，多实例部署时 SSE 才能跨实例广播：
# REDIS_URL="redis://localhost:6379/0"
REDIS_URL=""

# ---------- 业务 ----------
MIN_AVAILABLE_VOTERS=5
SSE_HEARTBEAT_SECONDS=15
